# Database Configuration (MongoDB Atlas Connection URI)
DB_URI=mongodb+srv://<username>:<password>@cluster0.8xlneak.mongodb.net/?appName=Cluster0
FALLBACK_DIRECT_URI=mongodb+srv://<username>:<password>@cluster0.8xlneak.mongodb.net/?appName=Cluster0

# Security and Session Management
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d
COOKIE_EXPIRE=7
ADMIN_JWT_SECRET=your_admin_jwt_secret_key_here
CRYPTO_SECRET_KEY=your_crypto_hex_secret_key_here

# Frontend Client Public Endpoints
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_APTUS_TOKEN=A1ED-AC9D6DEE-46A3DFD8
