PORT=3100
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
DB_URI=your_mongodb_connection_string
FALLBACK_DIRECT_URI=your_direct_mongodb_replica_set_connection_string
JWT_SECRET=your_jwt_secret
COOKIE_EXPIRE=7
JWT_EXPIRE=7d
ADMIN_JWT_SECRET=your_admin_jwt_secret
GROQ_API_KEY=your_server_groq_key_for_landing_bot_and_whisper_stt
GROQ_MODEL=openai/gpt-oss-120b

# Comma-separated list of additional allowed WebSocket CORS origins (e.g., https://myclientapp.com,https://demo.example.com)
SOCKET_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:3001

# Note: AI keys (Groq, OpenAI, Gemini, DeepSeek, etc.) are managed dynamically
#       by businesses via the dashboard portal under "AI Model & Keys".
