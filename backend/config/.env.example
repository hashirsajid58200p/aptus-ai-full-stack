PORT=3000
DB_URI=mongodb://your_mongodb_uri
JWT_SECRET=your_jwt_secret
COOKIE_EXPIRE=10
JWT_EXPIRE=10d
CRYPTO_SECRET_KEY=your_crypto_key
GROQ_API_KEY=your_groq_key

# The frontend URL for CORS access (Vercel client url)
FRONTEND_URL=https://your-frontend-vercel-url.vercel.app

# TEMPORARY static admin credentials — migrate to a DB-backed Admin model with bcrypt-hashed passwords before production.
ADMIN_EMAIL=admin@aptus.com
ADMIN_PASSWORD=change_this_placeholder_password
ADMIN_JWT_SECRET=your_admin_jwt_secret
