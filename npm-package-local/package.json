{
  "name": "aptus-ai-chatbot-widget",
  "version": "1.0.4",
  "description": "A customizable, themeable, secure React AI Chatbot widget component for business websites.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "bundle": "tsup src/index.ts",
    "prepublishOnly": "npm run bundle"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hashirsajid58200p/aptus-ai-chatbot-widget.git"
  },
  "bugs": {
    "url": "https://github.com/hashirsajid58200p/aptus-ai-chatbot-widget/issues"
  },
  "homepage": "https://github.com/hashirsajid58200p/aptus-ai-chatbot-widget#readme",
  "author": "Hashir Sajid",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.7",
    "prop-types": "^15.8.1",
    "react-icons": "^5.3.0"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0",
    "styled-components": ">=5.0.0"
  },
  "devDependencies": {
    "@types/babel__generator": "^7.6.8",
    "@types/babel__template": "^7.4.4",
    "@types/babel__traverse": "^7.20.6",
    "@types/node": "^22.5.4",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "postcss": "^8.4.42",
    "styled-components": "^6.1.13",
    "tailwindcss": "^3.4.10",
    "ts-loader": "^9.5.1",
    "tsup": "^8.5.1",
    "typescript": "^5.6.2",
    "vite": "^5.2.0"
  },
  "keywords": [
    "aptus",
    "aptus-ai",
    "chatbot",
    "react",
    "typescript",
    "npm",
    "ai-chatbot",
    "react-component",
    "customer-support",
    "chatbot-widget",
    "business-chatbot",
    "styled-components"
  ]
}
